# --- LLM (https://console.groq.com) ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.3

# --- Agent engine: auto (CrewAI if installed, else Groq SDK) | crewai | groq ---
AGENT_ENGINE=auto

# --- LangSmith tracing (https://smith.langchain.com) ---
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=devcrew-ai

# --- Firebase Auth verification ---
REQUIRE_AUTH=false
FIREBASE_PROJECT_ID=your-firebase-project-id

# --- CORS (comma separated; add your deployed frontend URL) ---
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000,https://your-frontend.vercel.app
